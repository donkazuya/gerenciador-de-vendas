{
  "name": "@gerenciador-de-vendas/source",
  "version": "0.0.0",
  "description": "Sistema Gerenciador de Vendas Desktop",
  "author": "Gerenciador de Vendas Team",
  "license": "MIT",
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "esbuild": true,
    "less": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "nx": true,
    "unrs-resolver": true
  },
  "main": "apps/frontend/src/main.js",
  "scripts": {
    "start:backend": "nx serve gerenciador-vendas-backend",
    "start:frontend": "nx serve gerenciador-vendas-frontend",
    "start:electron": "electron apps/frontend/src/main.js",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"wait-on http://localhost:3000/api http://localhost:4200 && npm run start:electron\"",
    "build": "nx run-many -t build --all",
    "build:backend": "nx build gerenciador-vendas-backend --configuration=production",
    "build:frontend": "nx build gerenciador-vendas-frontend --configuration=production",
    "build:electron": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win nsis",
    "format:check": "prettier --check \"apps/**/*.{ts,js,html,json,scss,css}\"",
    "format:write": "prettier --write \"apps/**/*.{ts,js,html,json,scss,css}\"",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:reset": "prisma migrate reset",
    "prisma:deploy": "prisma migrate deploy"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~21.1.0",
    "@angular-devkit/schematics": "~21.1.0",
    "@angular/build": "~21.1.0",
    "@angular/cli": "~21.1.0",
    "@angular/compiler-cli": "~21.1.0",
    "@angular/language-service": "~21.1.0",
    "@eslint/js": "^9.8.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/js": "^22.6.5",
    "@nx/nest": "^22.6.5",
    "@nx/node": "22.6.5",
    "@nx/web": "22.5.4",
    "@nx/webpack": "22.6.5",
    "@nx/workspace": "^22.6.5",
    "@schematics/angular": "~21.1.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^21.0.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "nx": "^22.6.5",
    "postcss": "^8.5.26",
    "prettier": "~3.6.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@angular/common": "~21.1.0",
    "@angular/compiler": "~21.1.0",
    "@angular/core": "~21.1.0",
    "@angular/forms": "~21.1.0",
    "@angular/platform-browser": "~21.1.0",
    "@angular/router": "~21.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "apex-grid": "^3.4.0",
    "apexcharts": "^7.1.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "igniteui-webcomponents": "^7.3.1",
    "lit": "^3.3.3",
    "ng-apexcharts": "^3.1.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "sqlite3": "^6.0.1",
    "typeorm": "^1.1.0"
  }
}
