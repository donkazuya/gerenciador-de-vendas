{
  "name": "@gerenciador-de-vendas/source",
  "version": "0.0.0",
  "license": "MIT",
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "esbuild": true,
    "less": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "nx": true,
    "unrs-resolver": true
  },
  "scripts": {
    "start:backend": "nx serve gerenciador-vendas-backend",
    "start:frontend": "nx serve gerenciador-vendas-frontend",
    "start:electron": "electron apps/frontend/src/main.js",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"wait-on http://localhost:4200 && npm run start:electron\"",
    "format:check": "prettier --check \"apps/**/*.{ts,js,html,json,scss,css}\"",
    "format:write": "prettier --write \"apps/**/*.{ts,js,html,json,scss,css}\""
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~21.1.0",
    "@angular-devkit/schematics": "~21.1.0",
    "@angular/build": "~21.1.0",
    "@angular/cli": "~21.1.0",
    "@angular/compiler-cli": "~21.1.0",
    "@angular/language-service": "~21.1.0",
    "@eslint/js": "^9.8.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/js": "^22.6.5",
    "@nx/nest": "^22.6.5",
    "@nx/node": "22.6.5",
    "@nx/web": "22.5.4",
    "@nx/webpack": "22.6.5",
    "@nx/workspace": "^22.6.5",
    "@schematics/angular": "~21.1.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^21.0.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "nx": "^22.6.5",
    "postcss": "^8.5.26",
    "prettier": "~3.6.2",
