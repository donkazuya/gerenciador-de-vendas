{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.gerenciador.vendas",
  "productName": "Gerenciador de Vendas",
  "copyright": "Copyright © 2026",
  "directories": {
    "output": "dist/executables"
  },
  "files": [
    "apps/frontend/src/main.js",
    "dist/apps/frontend/browser/**/*",
    "dist/apps/backend/**/*",
    "generated/prisma/**/*",
    "prisma/**/*"
  ],
  "extraResources": [
    {
      "from": "dev.db",
      "to": "database.db"
    }
  ],
  "asarUnpack": [
    "dist/apps/backend/**/*",
    "node_modules/**/*",
    "generated/prisma/**/*",
    "prisma/**/*"
  ],
  "extraMetadata": {
    "main": "apps/frontend/src/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Gerenciador de Vendas"
  }
}
